<%- include('../partials/header') %>

<% const currentYear = new Date().getFullYear(); %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2><i class="fas fa-money-bill-wave"></i> Quản Lý Học Phí</h2>
  <!-- <div>
    <a href="/academic/sync-enrollments" class="btn btn-warning me-2">
      <i class="fas fa-sync"></i> Đồng Bộ Enrollment
    </a>
  </div> -->
</div>

<!-- Thẻ thống kê -->
<div class="row mb-4">
  <div class="col-md-3">
    <div class="card stats-card card-tuition">
      <div class="card-body">
        <h5 class="card-title">Tổng Học Phí</h5>
        <h3 class="card-text text-primary">
          <%= stats.totalAmount.toLocaleString('vi-VN') %> ₫
        </h3>
        <p class="card-text text-muted">
          <small>Tháng <%= selectedMonth %>/<%= selectedYear %></small>
        </p>
      </div>
    </div>
  </div>
  
  <div class="col-md-3">
    <div class="card stats-card card-paid">
      <div class="card-body">
        <h5 class="card-title">Đã Thanh Toán</h5>
        <h3 class="card-text text-success">
          <%= stats.paidAmount.toLocaleString('vi-VN') %> ₫
        </h3>
        <p class="card-text text-muted">
          <small><%= stats.paidCount %> phiếu học phí</small>
        </p>
      </div>
    </div>
  </div>
  
  <div class="col-md-3">
    <div class="card stats-card card-pending">
      <div class="card-body">
        <h5 class="card-title">Chưa Thanh Toán</h5>
        <h3 class="card-text text-warning">
          <%= stats.pendingAmount.toLocaleString('vi-VN') %> ₫
        </h3>
        <p class="card-text text-muted">
          <small><%= stats.pendingCount %> phiếu học phí</small>
        </p>
      </div>
    </div>
  </div>
  
  <div class="col-md-3">
    <div class="card stats-card card-overdue">
      <div class="card-body">
        <h5 class="card-title">Quá Hạn</h5>
        <h3 class="card-text text-danger">
          <%= stats.overdueAmount.toLocaleString('vi-VN') %> ₫
        </h3>
        <p class="card-text text-muted">
          <small><%= stats.overdueCount %> phiếu học phí</small>
        </p>
      </div>
    </div>
  </div>
</div>

<!-- Bộ lọc tháng/năm -->
<div class="month-selector">
  <form id="monthYearForm" method="GET" action="/academic/tuition">
    <div class="row">
      <div class="col-md-4">
        <div class="form-group">
          <label for="month">Tháng</label>
          <select class="form-control" id="month" name="month">
            <% for(let i = 1; i <= 12; i++) { %>
              <option value="<%= i %>" <%= selectedMonth == i ? 'selected' : '' %>>
                Tháng <%= i %>
              </option>
            <% } %>
          </select>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="form-group">
          <label for="year">Năm</label>
          <select class="form-control" id="year" name="year">
            <% for(let i = currentYear - 2; i <= currentYear + 1; i++) { %>
              <option value="<%= i %>" <%= selectedYear == i ? 'selected' : '' %>>
                <%= i %>
              </option>
            <% } %>
          </select>
        </div>
      </div>
      
      <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-search"></i> Xem
        </button>
      </div>
    </div>
  </form>
</div>

<!-- Danh sách lớp học và học phí -->
<div class="card">
  <div class="card-header bg-primary text-white">
    <h5><i class="fas fa-list mr-2"></i> Danh Sách Lớp Học</h5>
  </div>
  <div class="card-body">
    <% if (schedules && schedules.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover">
          <thead class="thead-light">
            <tr>
              <th>Lớp</th>
              <th>Giáo Viên</th>
              <th>Tổng Học Sinh</th>
              <th>Thao Tác</th>
            </tr>
          </thead>
          <tbody>
            <% schedules.forEach(schedule => { %>
              <tr>
                <td><%= schedule.name %></td>
                <td><%= schedule.teacher ? schedule.teacher.name : 'Chưa phân công' %></td>
                <td>
                  <% if (typeof schedule.studentCount !== 'undefined') { %>
                    <%= schedule.studentCount %>
                  <% } else { %>
                    <%= schedule.students ? schedule.students.length : 0 %> 
                    <small class="text-muted">(chưa cập nhật)</small>
                  <% } %>
                </td>
                <td>
                  <a href="/academic/tuition/class/<%= schedule._id %>?month=<%= selectedMonth %>&year=<%= selectedYear %>" 
                     class="btn btn-sm btn-info">
                    <i class="fas fa-eye"></i> Xem Chi Tiết
                  </a>
                  <a href="/academic/tuition/report/<%= schedule._id %>" 
                     class="btn btn-sm btn-primary">
                    <i class="fas fa-chart-line"></i> Báo Cáo
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="alert alert-info">
        <i class="fas fa-info-circle mr-2"></i> Chưa có lớp học nào được tạo.
      </div>
    <% } %>
  </div>
</div>

<!-- Modal hiển thị danh sách học phí chưa thanh toán/quá hạn -->
<div class="modal fade" id="tuitionListModal" tabindex="-1" aria-labelledby="tuitionListModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tuitionListModalLabel">Danh sách học phí</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="tuitionListSearchWrap" class="mb-3" style="display: none;">
                    <input type="text" id="tuitionListSearch" class="form-control"
                           placeholder="Tìm theo lớp, học sinh, ghi chú...">
                </div>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr id="tuitionListHead">
                                <th>Lớp</th>
                                <th>Học sinh</th>
                                <th>Số tiền</th>
                                <th>Hạn thanh toán</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody id="tuitionListBody">
                            <!-- Dữ liệu sẽ được thêm vào đây bằng JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<style>
  .stats-card {
    border-radius: 10px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: all 0.3s;
    margin-bottom: 20px;
  }
  
  .stats-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
  }
  
  .card-tuition {
    border-left: 4px solid #3498db;
  }
  
  .card-paid {
    border-left: 4px solid #2ecc71;
  }
  
  .card-pending {
    border-left: 4px solid #f39c12;
  }
  
  .card-overdue {
    border-left: 4px solid #e74c3c;
  }
  
  .status-paid {
    color: #2ecc71;
    font-weight: bold;
  }
  
  .status-pending {
    color: #f39c12;
    font-weight: bold;
  }
  
  .status-overdue {
    color: #e74c3c;
    font-weight: bold;
  }
  
  .btn-tuition {
    margin-right: 5px;
    margin-bottom: 5px;
  }
  
  .month-selector {
    padding: 15px;
    background: #f8f9fa;
    border-radius: 10px;
    margin-bottom: 20px;
  }
  
  .table-hover tbody tr:hover {
    background-color: rgba(52, 152, 219, 0.1);
  }

  /* Thêm style cho thẻ thống kê có thể click */
  .card-paid, .card-pending, .card-overdue {
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .card-paid:hover, .card-pending:hover, .card-overdue:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
  }

  #tuitionListModal th.sortable {
    cursor: pointer;
    user-select: none;
  }

  #tuitionListModal th.sortable:hover {
    background-color: #e9ecef;
  }

  /* Style cho bảng trong modal */
  #tuitionListModal .table {
    margin-bottom: 0;
  }

  #tuitionListModal .table th {
    background-color: #f8f9fa;
    border-top: none;
  }

  #tuitionListModal .table td {
    vertical-align: middle;
  }

  #tuitionListModal .badge {
    padding: 5px 10px;
    font-weight: 500;
  }
</style>

<script>
  $(document).ready(function() {
    // Chọn tháng, năm tự động submit form
    $('#month, #year').change(function() {
      $('#monthYearForm').submit();
    });
    
    // Xử lý định dạng tiền tệ cho các input số tiền
    function formatMoney(input) {
      // Xóa tất cả ký tự không phải số
      let value = input.value.replace(/\D/g, '');
      
      // Định dạng số với dấu phân cách hàng nghìn theo chuẩn tiền Việt Nam
      if (value !== '') {
        value = new Intl.NumberFormat('vi-VN').format(parseInt(value));
      }
      
      // Gán lại giá trị đã định dạng
      input.value = value;
    }
    
    // Xử lý khi gửi form để chuyển về dạng số
    function prepareMoneyInput(inputId) {
      const input = document.getElementById(inputId);
      if (input) {
        input.value = input.value.replace(/\D/g, '');
      }
    }
    
    // Áp dụng định dạng tiền tệ cho tất cả input có class money-input
    $('.money-input').on('input', function() {
      formatMoney(this);
    });
    
    // Xử lý khi submit form - cách cũ, chỉ xử lý form cụ thể
    $('#addTuitionForm').submit(function() {
      prepareMoneyInput('amount');
    });
    
    $('#editTuitionForm').submit(function() {
      prepareMoneyInput('editAmount');
    });
    
    // Thêm xử lý cho tất cả form có chứa input tiền tệ
    $('form').submit(function() {
      $(this).find('.money-input').each(function() {
        this.value = this.value.replace(/\D/g, '');
      });
    });
    
    // Thêm định dạng tiền tệ khi hiển thị modal
    $('.edit-tuition-btn').click(function() {
      const tuitionId = $(this).data('id');
      const scheduleId = $(this).data('schedule');
      const studentId = $(this).data('student');
      const amount = $(this).data('amount');
      const month = $(this).data('month');
      const year = $(this).data('year');
      const note = $(this).data('note');
      const status = $(this).data('status');
      const dueDate = $(this).data('duedate');
      
      $('#editTuitionId').val(tuitionId);
      $('#editScheduleId').val(scheduleId);
      $('#editStudentId').val(studentId);
      $('#editAmount').val(parseInt(amount).toLocaleString('vi-VN'));
      $('#editMonth').val(month);
      $('#editYear').val(year);
      $('#editNote').val(note);
      $('#editStatus').val(status);
      $('#editDueDate').val(dueDate);
      
      editTuitionModal.show();
    });

    let paidTuitionData = [];
    let paidSortKey = 'dueDate';
    let paidSortDir = 'asc';

    const PAID_COLUMNS = [
      { key: 'className', label: 'Lớp', type: 'text' },
      { key: 'studentName', label: 'Học sinh', type: 'text' },
      { key: 'amount', label: 'Số tiền', type: 'number' },
      { key: 'dueDate', label: 'Hạn thanh toán', type: 'date' },
      { key: 'paymentDate', label: 'Ngày thanh toán', type: 'date' },
      { key: 'notes', label: 'Ghi chú', type: 'text' }
    ];

    function removeDiacritics(str) {
      return (str || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/đ/g, 'd')
        .toLowerCase();
    }

    function normalizePaidTuition(tuition) {
      return {
        ...tuition,
        className: tuition.schedule ? tuition.schedule.name : 'Không xác định',
        studentName: tuition.student ? tuition.student.name : 'Không xác định',
        notes: tuition.notes || ''
      };
    }

    function setupDefaultModalHead() {
      const thead = document.getElementById('tuitionListHead');
      thead.innerHTML = `
        <th>Lớp</th>
        <th>Học sinh</th>
        <th>Số tiền</th>
        <th>Hạn thanh toán</th>
        <th>Ghi chú</th>
      `;
    }

    function setupPaidModalHead() {
      const thead = document.getElementById('tuitionListHead');
      thead.innerHTML = PAID_COLUMNS.map(col => {
        const arrow = paidSortKey === col.key ? (paidSortDir === 'asc' ? ' ↑' : ' ↓') : '';
        return `<th class="sortable" data-sort-key="${col.key}">${col.label}${arrow}</th>`;
      }).join('');

      thead.querySelectorAll('th.sortable').forEach(th => {
        th.addEventListener('click', function() {
          const key = this.dataset.sortKey;
          if (paidSortKey === key) {
            paidSortDir = paidSortDir === 'asc' ? 'desc' : 'asc';
          } else {
            paidSortKey = key;
            paidSortDir = 'asc';
          }
          setupPaidModalHead();
          applyPaidFilterAndRender();
        });
      });
    }

    function comparePaidItems(a, b, key, type) {
      if (type === 'number') {
        return (a.amount || 0) - (b.amount || 0);
      }
      if (type === 'date') {
        if (key === 'paymentDate') {
          const da = a.paymentDate ? new Date(a.paymentDate).getTime() : null;
          const db = b.paymentDate ? new Date(b.paymentDate).getTime() : null;
          if (da === null && db === null) return 0;
          if (da === null) return 1;
          if (db === null) return -1;
          return da - db;
        }
        return new Date(a.dueDate).getTime() - new Date(b.dueDate).getTime();
      }
      const va = a[key] || '';
      const vb = b[key] || '';
      return va.localeCompare(vb, 'vi');
    }

    function sortPaidData(data) {
      const col = PAID_COLUMNS.find(c => c.key === paidSortKey);
      const sorted = [...data].sort((a, b) => comparePaidItems(a, b, paidSortKey, col ? col.type : 'text'));
      if (paidSortDir === 'desc') sorted.reverse();
      return sorted;
    }

    function renderPaidTuitionTable(data) {
      const tableBody = document.getElementById('tuitionListBody');
      const colCount = PAID_COLUMNS.length;
      tableBody.innerHTML = '';

      if (data.length === 0) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="${colCount}" class="text-center">
              <p class="text-muted">Không có học phí nào trong danh sách này.</p>
            </td>
          </tr>
        `;
        return;
      }

      data.forEach(tuition => {
        const row = document.createElement('tr');
        row.innerHTML = `
          <td>${tuition.className}</td>
          <td>${tuition.studentName}</td>
          <td>${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(tuition.amount)}</td>
          <td>${new Date(tuition.dueDate).toLocaleDateString('vi-VN')}</td>
          <td>${tuition.paymentDate ? new Date(tuition.paymentDate).toLocaleDateString('vi-VN') : ''}</td>
          <td>${tuition.notes}</td>
        `;
        tableBody.appendChild(row);
      });
    }

    function applyPaidFilterAndRender() {
      const searchTerm = removeDiacritics(document.getElementById('tuitionListSearch').value.trim());
      let filtered = paidTuitionData;
      if (searchTerm) {
        filtered = paidTuitionData.filter(item =>
          removeDiacritics(item.className).includes(searchTerm) ||
          removeDiacritics(item.studentName).includes(searchTerm) ||
          removeDiacritics(item.notes).includes(searchTerm)
        );
      }
      renderPaidTuitionTable(sortPaidData(filtered));
    }

    // Hàm hiển thị danh sách học phí
    function showTuitionList(status) {
        const modal = new bootstrap.Modal(document.getElementById('tuitionListModal'));
        const modalTitle = document.getElementById('tuitionListModalLabel');
        const tableBody = document.getElementById('tuitionListBody');
        const searchWrap = document.getElementById('tuitionListSearchWrap');
        const searchInput = document.getElementById('tuitionListSearch');

        const month = $('#month').val();
        const year = $('#year').val();
        const isPaid = status === 'paid';

        const titles = {
          pending: 'Danh sách học phí chưa thanh toán',
          overdue: 'Danh sách học phí quá hạn',
          paid: 'Danh sách học phí đã thanh toán'
        };
        modalTitle.textContent = titles[status] || 'Danh sách học phí';

        searchWrap.style.display = isPaid ? 'block' : 'none';
        searchInput.value = '';

        if (isPaid) {
          paidSortKey = 'dueDate';
          paidSortDir = 'asc';
          setupPaidModalHead();
          $('#tuitionListSearch').off('input').on('input', applyPaidFilterAndRender);
        } else {
          setupDefaultModalHead();
          $('#tuitionListSearch').off('input');
        }

        const colSpan = isPaid ? PAID_COLUMNS.length : 5;
        tableBody.innerHTML = `
            <tr>
                <td colspan="${colSpan}" class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Đang tải danh sách...</p>
                </td>
            </tr>
        `;

        modal.show();

        $.ajax({
            url: `/academic/tuition/list/${status}`,
            method: 'GET',
            data: {
                month: month,
                year: year
            },
            success: function(data) {
                if (data.success) {
                    if (isPaid) {
                        paidTuitionData = (data.tuitions || []).map(normalizePaidTuition);
                        applyPaidFilterAndRender();
                        return;
                    }

                    tableBody.innerHTML = '';

                    if (data.tuitions && data.tuitions.length > 0) {
                        data.tuitions.forEach(tuition => {
                            const row = document.createElement('tr');
                            row.innerHTML = `
                                <td>${tuition.schedule ? tuition.schedule.name : 'Không xác định'}</td>
                                <td>${tuition.student ? tuition.student.name : 'Không xác định'}</td>
                                <td>${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(tuition.amount)}</td>
                                <td>${new Date(tuition.dueDate).toLocaleDateString('vi-VN')}</td>
                                <td>${tuition.notes || ''}</td>
                            `;
                            tableBody.appendChild(row);
                        });
                    } else {
                        tableBody.innerHTML = `
                            <tr>
                                <td colspan="5" class="text-center">
                                    <p class="text-muted">Không có học phí nào trong danh sách này.</p>
                                </td>
                            </tr>
                        `;
                    }
                } else {
                    throw new Error(data.message || 'Không thể lấy danh sách học phí');
                }
            },
            error: function(xhr, status, error) {
                console.error('Lỗi khi lấy danh sách học phí:', error);
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="${colSpan}" class="text-center text-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Đã xảy ra lỗi khi tải danh sách: ${error}
                        </td>
                    </tr>
                `;
            }
        });
    }

    $('.card-paid').click(function() {
        showTuitionList('paid');
    });

    // Xử lý click vào thẻ chưa thanh toán
    $('.card-pending').css('cursor', 'pointer').click(function() {
        showTuitionList('pending');
    });

    // Xử lý click vào thẻ quá hạn
    $('.card-overdue').css('cursor', 'pointer').click(function() {
        showTuitionList('overdue');
    });
  });
</script>

<%- include('../partials/footer') %> 